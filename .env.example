# ─── Backend URL (for the /api/v1 gateway) ────────────────────
# In development: leave unset — with no BACKEND_URL the same-origin
# gateway serves the embedded read-only API (src/lib/api-mode.ts);
# "proxy" mode falls back to http://localhost:4000.
# In production: set to your Railway backend URL — deploy.yml deploys
# backend-node/ to Railway, and Render is dead (the old render.yaml
# blueprint was removed; see backend-node/README.md).
#BACKEND_URL=https://<your-service>.up.railway.app

# ─── Roy Live (WebSocket mini-service) ───────────────────────
# Comma-separated exact origins allowed to connect to live-service (:3003).
# Unset/empty → dev defaults (localhost:3000, localhost:3323). MUST be set
# to the real origin(s) in production — see mini-services/live-service/README.md.
#LIVE_ALLOWED_ORIGINS=https://roycss.com

# ─── Database (used by root Prisma) ──────────────────────────
DATABASE_URL=file:./dev.db

{
  "name": "roycss-cli",
  "version": "2.0.0",
  "description": "CLI tool for RoyCSS — search, add, and manage 1569+ production-ready CSS effects.",
  "type": "module",
  "bin": {
    "roycss": "./index.js"
  },
  "files": [
    "index.js",
    "effects.json",
    "README.md"
  ],
  "scripts": {
    "dev": "bun --hot ../src/cli/index.ts",
    "build": "bun build ../src/cli/index.ts --outdir . --target node --outfile index.js",
    "start": "node index.js"
  },
  "keywords": [
    "cli",
    "css",
    "framework",
    "effects",
    "animations",
    "roycss",
    "scaffold",
    "search",
    "frontend"
  ],
  "author": "Royford Wanyoike Wamaitha <roywanyoike328@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Roy-Wanyoike/roycss"
  },
  "homepage": "https://github.com/Roy-Wanyoike/roycss",
  "bugs": {
    "url": "https://github.com/Roy-Wanyoike/roycss/issues"
  },
  "engines": {
    "node": ">=18"
  }
}

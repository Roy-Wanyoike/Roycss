{
  "name": "roycss",
  "version": "2.0.0",
  "description": "RoyCSS — 1,959 production-ready CSS effects. Zero JavaScript runtime. OKLCH colors, logical properties, container queries, scroll-driven animations.",
  "keywords": [
    "css",
    "css-framework",
    "css-effects",
    "animations",
    "transitions",
    "oklch",
    "frontend",
    "design-system",
    "utility-first",
    "roycss"
  ],
  "homepage": "https://github.com/Roy-Wanyoike/Roycss",
  "repository": {
    "type": "git",
    "url": "https://github.com/Roy-Wanyoike/Roycss.git"
  },
  "bugs": {
    "url": "https://github.com/Roy-Wanyoike/Roycss/issues"
  },
  "author": "Royford Wanyoike Wamaitha <roywanyoike328@gmail.com>",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Roy-Wanyoike"
  },
  "files": [
    "dist",
    "!dist/pro-components.json",
    "dist/tokens.d.ts",
    "dist/tokens.dtcg.json",
    "dist/roycss.rules.md",
    "dist/roycss.system-prompt.md",
    "dist/roycss.grammar.json",
    "dist/roycss.training-pairs.jsonl",
    "dist/roycss.manifest.json",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/effects.js",
  "module": "dist/effects.js",
  "types": "dist/effects.d.ts",
  "exports": {
    ".": {
      "types": "./dist/effects.d.ts",
      "import": "./dist/effects.js",
      "require": "./dist/effects.cjs",
      "default": "./dist/effects.js"
    },
    "./css": "./dist/roycss.css",
    "./css/min": "./dist/roycss.min.css",
    "./effects.json": "./dist/effects.json",
    "./class-index": "./dist/class-index.json",
    "./motion-library": "./dist/motion-library.json",
    "./critical.css": "./dist/roycss-critical.css",
    "./fallbacks": "./dist/roycss-fallbacks.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "prisma generate && next build",
    "build:standalone": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "build:package": "bun run scripts/build-package.ts",
    "gen:ai": "bun run scripts/generate-ai-artifacts.ts",
    "ai:check": "bun run scripts/generate-ai-artifacts.ts --check",
    "gen:a11y": "bun run scripts/generate-effect-a11y.ts",
    "tokens:emit": "bun run scripts/emit-tokens.ts",
    "tokens:check": "bun run scripts/emit-tokens.ts --check",
    "gen:manifest": "bun run scripts/generate-manifest.ts",
    "gen:manifest:check": "bun run scripts/generate-manifest.ts --check",
    "build:cli": "bun build src/cli/index.ts --outdir cli --target node --outfile index.js",
    "prepublishOnly": "bun run build:package",
    "publish:validate": "bun run scripts/publish/validate.ts",
    "publish:prepare": "bun run scripts/publish/prepare.ts",
    "publish:release": "bun run scripts/publish/release.ts",
    "publish:ci": "npm publish --provenance --access public",
    "changeset": "changeset",
    "version": "changeset version",
    "start": "next start",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "perf:budget": "bun run scripts/perf-budget.ts",
    "perf:benchmark": "bun run perf/benchmark.ts",
    "size": "size-limit"
  },
  "dependencies": {},
  "peerDependencies": {},
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@lhci/cli": "^0.15.1",
    "@mdxeditor/editor": "^3.55.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.63.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@reactuses/core": "^6.5.9",
    "@size-limit/file": "^13.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-table": "^8.21.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^4.1.11",
    "bun-types": "1.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "framer-motion": "^12.43.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.525.0",
    "next": "^16.3.5",
    "next-intl": "^4.14.5",
    "next-themes": "^0.4.6",
    "prisma": "^6.19.3",
    "react": "^19.3.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.10.1",
    "sharp": "^0.35.4",
    "size-limit": "^14.0.0",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.186.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "uuid": "^14.0.2",
    "vaul": "^1.1.2",
    "vitest": "^4.1.11",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
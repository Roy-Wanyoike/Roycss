# ─── Backend URL (for Vercel deployment) ────────────────────────
# In development: not needed (defaults to http://localhost:4000)
# In production (Vercel): set to your backend URL (Railway/Fly.io/Render)
BACKEND_URL=http://localhost:4000

# ─── Live Service URL (for WebSocket) ──────────────────────────
LIVE_URL=http://localhost:3003

# ─── Database (used by frontend for root Prisma) ──────────────
DATABASE_URL=file:./dev.db

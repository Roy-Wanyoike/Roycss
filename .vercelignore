# ═══ RoyCSS — .vercelignore ═══════════════════════════════════════════
# Exclude everything `next build` never touches (verified by import audit
# 2026-09, issue: "11GB in Vercel"). Site build needs ONLY:
#   src/ public/ prisma/ package.json bun.lock next.config.ts
#   postcss.config.mjs tailwind.config.ts tsconfig.json components.json
# ═════════════════════════════════════════════════════════════════════
# npm package artifacts (regenerated by `bun run build:package`; no src/ import)
dist/
# Non-site runtimes / services
backend-node/
backend-go/
mcp-server/
mini-services/
vscode-extension/
cli/
# Plugin packages (npm consumers only; not in workspaces)
packages/
# QA / audit / test tooling + tracked reports
tests/
perf/
a11y/
security/
# Docs source (generated JSON blobs are committed under src/)
docs/
rfcs/
# Build tooling not invoked by `prisma generate && next build`
scripts/
database/
infrastructure/
.github/
# Stray files
public/__axe.min.js
render.yaml
Caddyfile
lighthouserc.json
playwright.config.ts
vitest.config.ts
API.md
MAINTAINERS.md
CODE_OF_CONDUCT.md

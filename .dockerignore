# ═══════════════════════════════════════════════════════════════
# RoyCSS — .gitignore
# Comprehensive — excludes all dev/build/secret/cache artifacts
# ═══════════════════════════════════════════════════════════════

# ─── Dependencies ──────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
# bun.lockb
backend/bun.lock

# ─── Next.js ───────────────────────────────────────────────────
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# ─── Production build artifacts ────────────────────────────────
# dist/ at root IS committed (roycss.css, effects.json — published npm artifacts)
# backend/dist/ is regenerated — don't commit
backend/dist/
dist/coverage/

# ─── Testing & coverage ────────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/
test-results.xml
*.lcov
backend/coverage/
backend/test.db
backend/test.db-journal
backend/prisma/test.db*
backend/prisma/custom.db*

# ─── Environment variables (NEVER commit secrets) ─────────────
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# ─── Database (SQLite — regenerated per environment) ───────────
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm
backend/prisma/dev.db*
backend/prisma/migrations/dev.db*
# prisma/migrations/dev.db*
prisma/generated/

# ─── Debug logs ────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
dev.log
dev.out.log
server.log
backend/*.log
/tmp/*.log

# ─── OS files ───────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~

# ─── Vercel ────────────────────────────────────────────────────
.vercel

# ─── Local config & agent context ──────────────────────────────
local-*
.claude
.z-ai-config
agent-ctx/
.zscripts/
.roycss-cache/
upload/

# ─── Skills (not part of the app) ──────────────────────────────
/skills/

# ─── Tool results & screenshots (not for source control) ────────
.tool-results/
tool-results/
screenshots/
tests/i18n/screenshots/
tests/screenshots/

# ─── Curated results (regenerated by scripts) ──────────────────
scripts/curate-results/

# ─── Worklog & dev notes ───────────────────────────────────────
worklog.md
.agent

# ─── Bundled zip & tarball artifacts ───────────────────────────
# RoyCSS.zip is rebuilt from source — don't commit the binary
*.zip
# ...but DO track the downloadable zip in public/
!public/roycss.zip
*.tgz
*.tar.gz

# ─── Miscellaneous ─────────────────────────────────────────────
.cache/
.turbo/
.eslintcache

# ─── Stray clones / downloaded archives (not part of source) ───
RoyCSS-evolved/
download/
portfolio/
inspector/

# ─── Reports (regenerated, not source) ─────────────────────────
roycss-upgrade-report.md

# ─── IDE / editor ───────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.bak

# ─── Playwright (browser binaries — too big, regenerated) ─────
# (Playwright browsers live in ~/.cache/ms-playwright/ — not in repo)
# But ignore any local playwright config that's not for source
playwright.config.local.ts

# ─── Sentry / observability (local config) ─────────────────────
.sentryclrc
sentry.properties

# ─── Misc pids / lock files ────────────────────────────────────
*.pid
# *.lock
!bun.lock
!backend/bun.lock
.pids/

# ─── Backup files ──────────────────────────────────────────────
*.bak
*.backup
*.orig

# ─── Stray folders (not part of source) ─────────────────────────
inspector/
performance/
test-results/
upload/
vscode-support/
compat/
examples/
skills/
.changeset/
*.bak
*.zip

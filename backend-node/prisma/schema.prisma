generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  passwordHash String
  name         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime @updatedAt
  favorites    EffectFavorite[]
  collections  Collection[]
  memberships  Membership[]
  @@index([email])
}

model EffectFavorite {
  id        String   @id @default(cuid())
  userId    String
  effectId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, effectId])
  @@index([userId])
  @@index([effectId])
}

model Collection {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  effectIds   String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([userId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([email])
  @@index([createdAt])
}

model LearningPath {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  description  String
  level        String
  lessonsJson  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
model PathProgress {
  id                   String   @id @default(cuid())
  userId               String?
  pathId               String
  completedLessonsJson String
  lastLessonId         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  @@unique([userId, pathId])
  @@index([userId])
  @@index([pathId])
}
model Challenge {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  description   String
  difficulty    String
  prompt        String
  starterCode   String
  solutionCode  String
  tagsJson      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
model ChallengeSubmission {
  id           String   @id @default(cuid())
  userId       String?
  challengeId  String
  code         String
  passed       Boolean  @default(false)
  score        Int      @default(0)
  createdAt    DateTime @default(now())
  @@index([userId, challengeId])
  @@index([challengeId])
}
model Certification {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String
  requirementsJson String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
model CertificationAttempt {
  id              String   @id @default(cuid())
  userId          String?
  certificationId String
  score           Int      @default(0)
  passed          Boolean  @default(false)
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  @@index([userId, certificationId])
  @@index([certificationId])
}
model AuditProject {
  id           String   @id @default(cuid())
  userId       String?
  name         String
  description  String
  url          String
  status       String   @default("active")
  lastAuditAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([userId])
}
model AuditResult {
  id             String   @id @default(cuid())
  projectId      String
  summaryJson    String
  violationsJson String
  score          Int      @default(0)
  createdAt      DateTime @default(now())
  @@index([projectId])
}
model CloudProject {
  id           String   @id @default(cuid())
  userId       String?
  name         String
  provider     String
  region       String
  status       String   @default("active")
  configJson   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([userId])
}
model Deployment {
  id           String   @id @default(cuid())
  projectId    String?
  environment  String
  status       String   @default("pending")
  url          String?
  logsUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([projectId])
}
model FleetProject {
  id           String   @id @default(cuid())
  userId       String?
  name         String
  description  String
  serviceCount Int      @default(0)
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([userId])
}
model StudioProject {
  id           String   @id @default(cuid())
  userId       String?
  name         String
  description  String
  filesJson    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([userId])
}
model PreviewBranch {
  id           String   @id @default(cuid())
  projectId    String?
  branchName   String
  previewUrl   String
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([projectId])
}
model WorkspaceResource {
  id           String   @id @default(cuid())
  userId       String?
  type         String
  name         String
  contentJson  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([userId, type])
}
model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  plan      String   @default("free")
  seats     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
}

// ─── Org-scoped authorization (issue #64) ─────────────────────────────────
// Links a User to an Organization with a role. Consumed by the
// `requireRole()` middleware (src/server/middleware/auth.ts) which
// enforces a role hierarchy OWNER > ADMIN > MEMBER > VIEWER.
//
// NOTE: Prisma `enum` is not supported on SQLite, so `role` is a plain
// string; the allowed values are validated application-side by
// requireRole (see ORG_ROLES in the middleware).
model Membership {
  id        String       @id @default(cuid())
  orgId     String
  userId    String
  role      String       @default("MEMBER") // OWNER | ADMIN | MEMBER | VIEWER
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId])
}
model Team {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([orgId, slug])
  @@index([orgId])
}
model License {
  id        String   @id @default(cuid())
  orgId     String
  key       String   @unique
  tier      String   @default("free")
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([orgId])
}
model EnterpriseAuditLog {
  id            String   @id @default(cuid())
  orgId         String
  userId        String?
  action        String
  resourceType  String
  resourceId    String?
  metadataJson  String
  createdAt     DateTime @default(now())
  @@index([orgId, createdAt])
}
model GovernancePolicy {
  id         String   @id @default(cuid())
  orgId      String?
  name       String
  rulesJson  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([orgId])
}
model GovernanceApproval {
  id           String   @id @default(cuid())
  policyId     String
  userId       String?
  resourceType String
  resourceId   String

# ─── Dependencies ──────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
bun.lockb

# ─── Next.js ───────────────────────────────────────────────────
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# ─── Production build artifacts ────────────────────────────────
dist/coverage/

# Note: dist/ IS committed (roycss.css, effects.json, etc. are the
# published npm package artifacts). Only dist/coverage/ is ignored.

# ─── Testing & coverage ────────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/
test-results.xml
*.lcov

# ─── Environment variables ─────────────────────────────────────
.env
.env.*
!.env.example

# ─── Debug logs ────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
dev.log
dev.out.log
server.log

# ─── OS files ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.pem

# ─── IDE & editor ──────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
*~
.agent

# ─── Vercel ────────────────────────────────────────────────────
.vercel

# ─── Database (SQLite — regenerated per environment) ───────────
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm
prisma/migrations/dev.db*

# ─── Prisma ────────────────────────────────────────────────────
prisma/generated/

# ─── Local config & agent context ──────────────────────────────
local-*
.claude
.z-ai-config
agent-ctx/
.zscripts/

# ─── Skills (not part of the app) ──────────────────────────────
/skills/

# ─── Tool results & screenshots (not for source control) ──────
.tool-results/
tool-results/
screenshots/
tests/i18n/screenshots/
tests/screenshots/

# ─── Curated results (regenerated by scripts) ──────────────────
scripts/curate-results/

# ─── Worklog & dev notes ───────────────────────────────────────
worklog.md

# ─── Bundled zip & tarball artifacts ───────────────────────────
# RoyCSS.zip is rebuilt from source — don't commit the binary
*.zip
# ...but DO track the downloadable zip in public/
!public/roycss.zip
*.tgz

# ─── Miscellaneous ─────────────────────────────────────────────
.cache/
.turbo/
.eslintcache

# ─── Stray clones / downloaded archives (not part of source) ───
RoyCSS-evolved/
download/
portfolio/
inspector/

# ─── Build artifacts that shouldn't be committed ────────────────
backend/dist/
backend/prisma/test.db*
backend/prisma/custom.db*
backend/test.db*

# ─── Misc dev artifacts ─────────────────────────────────────────
.zscripts/
.roycss-cache/
upload/

# ─── Reports (regenerated, not source) ─────────────────────────
roycss-upgrade-report.md

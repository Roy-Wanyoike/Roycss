# ─── RoyCSS Backend — Environment Variables ───────────────────────────────────
# Copy to .env and adjust as needed. All vars have safe defaults for dev.
# `bun run dev` loads this file automatically at boot (src/config/dotenv.ts,
# issue #208); values already present in the shell win over this file.
# Blank optional values (SUPABASE_URL=, RESEND_API_KEY=, …) are treated
# as unset where it matters — the server boots with this file as-is.

# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# CORS — comma-separated list of allowed origins.
# Dev-mode reflection is GATED to localhost-family origins (issue #209);
# arbitrary origins are rejected with a 403 in every mode. Testing from
# a LAN device (phone on 192.168.x.x)? Add its origin here, e.g.
#   CORS_ORIGINS=http://localhost:3000,http://192.168.1.50:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (SQLite for dev; swap to postgresql:// for prod)
DATABASE_URL="file:./dev.db"

# Auth — in production these MUST be ≥48 chars and not placeholder-ish
# (NODE_ENV=production refuses to boot otherwise — see src/config/env.ts).
# Generate: `openssl rand -base64 48`
JWT_SECRET=change-me-in-production-please-use-a-64-char-random-string
JWT_REFRESH_SECRET=change-me-too-different-from-jwt-secret-64-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_GENERAL=100
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_CONTACT=5
# Per-route tiers (PF-009 / issue #94 A5) — AI generation and search
# endpoints. These two were previously undocumented (audit F-16).
RATE_LIMIT_MAX_AI=20
RATE_LIMIT_MAX_SEARCH=60

# Per-API-key rate limiting (issue #65) — applies when a request
# authenticates via X-API-Key, in addition to the per-IP limits above.
# Default: 120 requests / 60s per key.
API_KEY_RATE_LIMIT_MAX=120
API_KEY_RATE_LIMIT_WINDOW_MS=60000

# ─── Redis rate limiting (optional — issue #118 / PRD-F10) ──────────────
# Unset (or blank) = the default in-process sliding-window limiters —
# fine for a single backend replica. Set to a redis:// or rediss:// URL
# and all five route tiers + the per-API-key limiter share their counters
# through Redis: limits survive deploys and hold when the backend scales
# past one replica. A connection failure at boot (or Redis going down
# mid-flight) logs and falls back to the in-memory limiter — the API
# never fails to start or serve because of Redis.
# REDIS_URL=redis://localhost:6379
REDIS_URL=

# Effects data source — path to the effects.json produced by the Next.js build
EFFECTS_DATA_PATH=../dist/effects.json

# ─── Supabase (optional — only if using Supabase auth/storage in production) ──
# Blank = unset (issue #208 — a copied .env.example must not brick boot).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# ─── External LLM providers (optional — RoyAI / RoyPair / RoyMentor use these) ─
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Transactional email (optional — contact form + auth emails via Resend) ───
# When RESEND_API_KEY is unset, the mailer falls back to the mock transport
# (emails are logged, never sent) — auth flows AND the contact-form
# confirmation (issue #209) still work end-to-end in dev: watch the log
# for "Email sent (mock transport — not delivered)".
RESEND_API_KEY=

# Canonical frontend origin — emailed action links (verify-email,
# reset-password) are built against this URL.
APP_URL=http://localhost:3000

# Resend sender identity (must be a domain verified in your Resend account).
MAIL_FROM=RoyCSS <onboarding@resend.dev>

# ─── Error monitoring (optional — Sentry DSN for backend error tracking) ─────
# Format: https://<public-key>@<host>/<project-id> (Sentry → Settings → Client Keys).
# Unset = Sentry stays fully disabled (no init, error middleware is a
# pass-through — see src/lib/sentry.ts). Set = errors are reported upstream
# from the Railway backend; only 5xx-class failures are sent.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_DSN=

# ─── Object storage (optional — S3-compatible backend for RoyStorage) ────────
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=

# ─── CDN (optional — used by RoyCDN module for distribution) ──────────────────
CDN_API_TOKEN=
CDN_PROVIDER=

# ─── Integrations (optional — used by Figma / GitHub / npm sync modules) ─────
FIGMA_TOKEN=
GITHUB_TOKEN=
NPM_TOKEN=

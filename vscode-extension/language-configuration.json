{
  "comments": {
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "`", "close": "`", "notIn": ["string"] },
    { "open": "/*", "close": " */", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" },
    { "open": "`", "close": "`" }
  ],
  "onEnterRules": [
    {
      "beforeText": { "pattern": "^\\s*\\/\\*\\*(?!\\/)([^\\*]|\\*(?!\\/))*$" },
      "afterText": { "pattern": "^\\s*\\*\\/$" },
      "action": {
        "indent": "indentOutdent",
        "appendText": " * "
      }
    },
    {
      "beforeText": { "pattern": "^\\s*\\*\\s*$" },
      "action": {
        "indent": "none",
        "appendText": "* "
      }
    },
    {
      "beforeText": { "pattern": "\\{\\s*$" },
      "action": { "indent": "indent" }
    },
    {
      "beforeText": { "pattern": "\\}\\s*$" },
      "action": { "indent": "outdent" }
    }
  ],
  "wordPattern": "(?<![\\w-])(?:roycss-[A-Za-z0-9-]+|[A-Za-z][A-Za-z0-9-]*)(?![\\w-])",
  "folding": {
    "markers": {
      "start": "^\\s*/\\*\\s*#?region\\b",
      "end": "^\\s*/\\*\\s*#?endregion\\b"
    }
  }
}

{
  "name": "roycss-backend",
  "version": "1.0.0",
  "description": "RoyCSS backend infrastructure \u2014 Express + Prisma + JWT + Zod. REST API for effects, recipes, patterns, contact, and auth.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "DATABASE_URL=\"file:./test.db\" JWT_SECRET=\"test-jwt-secret-32-chars-long\" JWT_REFRESH_SECRET=\"test-refresh-secret-32-chars\" vitest run tests/integration",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "api:check": "tsx scripts/check-api-docs.ts",
    "api:gen": "tsx scripts/gen-api-md.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@prisma/client": "^6.11.1",
    "@supabase/supabase-js": "^2.112.3",
    "@types/semver": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "chrome-launcher": "^1.2.1",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^4.1.0",
    "lighthouse": "^13.4.1",
    "lucide-react": "^1.33.0",
    "morgan": "^1.10.0",
    "playwright": "^1.62.1",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "prisma": "^6.11.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
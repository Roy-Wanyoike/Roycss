# ─── Backend URL (for production deployment) ──────────────────
# In development: defaults to http://localhost:4000
# In production (Vercel): set to your Render backend URL
BACKEND_URL=https://roycss.onrender.com

# ─── Live Service URL (for WebSocket) ────────────────────────
LIVE_URL=http://localhost:3003

# ─── Database (used by root Prisma) ──────────────────────────
DATABASE_URL=file:./dev.db

# ════════════════════════════════════════════════════════════════════
# RoyCSS Backend — Environment Variables (TEMPLATE — NO REAL SECRETS)
# ════════════════════════════════════════════════════════════════════
# Copy to `.env` and fill in real values. ALL secrets below MUST be
# empty in this template — never commit a populated .env file.
#
# The schema (validated at boot by `src/config/env.ts` using Zod) is
# the source of truth: required fields throw on startup if missing,
# optional fields default to safe dev values.
#
# Generate strong JWT secrets in production:
#   openssl rand -base64 64
# ════════════════════════════════════════════════════════════════════

# ─── Server ─────────────────────────────────────────────────────────
# Node runtime mode: "development" | "test" | "production".
NODE_ENV=development
# Port the Express backend listens on.
PORT=4000
# Log verbosity: "debug" | "info" | "warn" | "error".
LOG_LEVEL=info

# ─── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins for cross-origin
# requests to the API. The Next.js app origin must be listed here.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Database ──────────────────────────────────────────────────────
# SQLite for local dev. Swap to a postgresql:// URL in production.
DATABASE_URL="file:./dev.db"

# ─── Auth (JWT) ────────────────────────────────────────────────────
# HS256 signing secrets for access + refresh tokens. MUST be at
# least 16 chars; use a 64-char random string in production. Use a
# DIFFERENT value for the refresh secret so an access-token leak
# cannot mint refresh tokens.
JWT_SECRET=
JWT_REFRESH_SECRET=
# Token lifetimes (human-readable: "15m", "7d", etc.).
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Rate Limiting ─────────────────────────────────────────────────
# Sliding-window rate-limiter config (per-IP). The contact form is
# the most restrictive to deter spam; auth is restrictive to deter
# brute-force; general is permissive for normal browsing.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_GENERAL=100
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_CONTACT=5

# ─── Effects Data Source ───────────────────────────────────────────
# Path to the effects.json artifact produced by the Next.js build
# (relative to backend/). Used to seed the in-memory effects cache.
EFFECTS_DATA_PATH=../dist/effects.json

# ─── Supabase (Postgres + Auth + Storage) ──────────────────────────
# Used in production in place of SQLite. The publishable key is safe
# to expose to the browser; the secret key is server-only and MUST
# NEVER appear in client code or be committed.
# Project URL (e.g. https://xxxxxxxxxxxx.supabase.co).
SUPABASE_URL=
# Browser-safe anon/publishable key.
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key — full bypass of RLS. NEVER expose to client.
SUPABASE_SECRET_KEY=
# JWKS URL for verifying Supabase-issued JWTs server-side.
SUPABASE_JWKS_URL=

# ─── LLM Providers (Roy-AI / Roy-Mentor / Roy-Pair) ────────────────
# Either or both can be set. If both are empty, the LLM modules
# fall back to deterministic mock responses so dev still works.
# OpenAI API key (sk-...). Get from https://platform.openai.com/api-keys.
OPENAI_API_KEY=
# Anthropic API key (sk-ant-...). Get from https://console.anthropic.com.
ANTHROPIC_API_KEY=

# ─── Transactional Email (Resend) ──────────────────────────────────
# Used for contact-form autoresponder + auth email verification.
# Get from https://resend.com/api-keys.
RESEND_API_KEY=

# ─── Error Tracking (Sentry) ───────────────────────────────────────
# Sentry DSN (public identifier — not a secret). Leave empty to disable.
SENTRY_DSN=

# ─── Object Storage (S3-compatible) ────────────────────────────────
# Used for uploads / asset storage. Works with AWS S3, R2, MinIO,
# Backblaze B2, etc. — set ENDPOINT + REGION to match the provider.
# Server endpoint (e.g. https://xxx.r2.cloudflarestorage.com).
STORAGE_ENDPOINT=
# Bucket name (must already exist on the provider).
STORAGE_BUCKET=
# Access key ID (server-only credential).
STORAGE_ACCESS_KEY_ID=
# Secret access key (server-only credential). NEVER commit.
STORAGE_SECRET_ACCESS_KEY=
# Region (e.g. auto for R2, us-east-1 for AWS).
STORAGE_REGION=

# ─── CDN ───────────────────────────────────────────────────────────
# Token used by the CDN module to purge / invalidate cached assets.
# Provider name (e.g. "cloudflare" | "fastly" | "bunny" | "vercel").
CDN_PROVIDER=
# API token / purge key for the configured CDN provider.
CDN_API_TOKEN=

# ─── Figma ↔ GitHub Design-Token Sync ──────────────────────────────
# Used by the `/sync` module to pull design tokens from Figma and
# push them to a GitHub repo. Both are personal-access tokens.
# Figma personal-access token (figd_...). Get from Figma → Settings.
FIGMA_TOKEN=
# GitHub personal-access token (ghp_...) with repo scope.
GITHUB_TOKEN=

# ─── npm Registry (publishing) ─────────────────────────────────────
# Used by `scripts/publish/*` to publish the RoyCSS package to npm.
# Auth token from your ~/.npmrc (//registry.npmjs.org/:_authToken=...).
NPM_TOKEN=

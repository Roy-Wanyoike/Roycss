{
  "name": "roycss-backend",
  "version": "1.0.0",
  "description": "RoyCSS backend infrastructure — Express + Prisma + JWT + Zod. REST API for effects, recipes, patterns, contact, and auth.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "DATABASE_URL=\"file:./test.db\" JWT_SECRET=\"test-jwt-secret-32-chars-long\" JWT_REFRESH_SECRET=\"test-refresh-secret-32-chars\" vitest run tests/integration",
    "test:coverage": "DATABASE_URL=\"file:./test.db\" JWT_SECRET=\"test-jwt-secret-32-chars-long\" JWT_REFRESH_SECRET=\"test-refresh-secret-32-chars\" vitest run --coverage",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "api:check": "tsx scripts/check-api-docs.ts",
    "api:gen": "tsx scripts/gen-api-md.ts",
    "api:surface": "tsx scripts/check-api-stability.ts",
    "api:surface:update": "tsx scripts/check-api-stability.ts --update",
    "gen:openapi": "tsx scripts/gen-openapi.ts",
    "gen:openapi:check": "tsx scripts/gen-openapi.ts --check"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.75.0",
    "@supabase/supabase-js": "^2.116.0",
    "@types/semver": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.47.0",
    "morgan": "^1.12.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.3",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "chrome-launcher": "^1.2.1",
    "jwks-rsa": "^4.1.0",
    "lighthouse": "^13.4.1",
    "playwright": "^1.63.0",
    "playwright-core": "^1.63.0",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
